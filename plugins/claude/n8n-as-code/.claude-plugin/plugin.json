{
  "name": "n8n-as-code",
  "version": "2.4.1",
  "description": "Claude Code plugin for n8n-as-code. Adds the n8n-architect skill, which drives the n8nac CLI for workflows and the n8n-manager CLI for local managed instances.",
  "author": {
    "name": "Etienne Lescot",
    "url": "https://github.com/EtienneLescot"
  },
  "license": "MIT",
  "icon": "./assets/icon.svg",
  "homepage": "https://n8nascode.dev/docs/usage/claude-plugin/",
  "repository": "https://github.com/EtienneLescot/n8n-as-code",
  "mcpServers": {
    "n8n-as-code": {
      "command": "npx",
      "args": [
        "-y",
        "@n8n-as-code/mcp@2.2.1"
      ]
    }
  },
  "skills": "./skills/",
  "keywords": [
    "n8n",
    "workflow",
    "automation",
    "claude-code",
    "plugin",
    "skill",
    "n8nac"
  ]
}
